{
    "name": "cse470/uninexus-mvc",
    "type": "project",
    "description": "UniNexus - Consultation Slot Booking & Meeting Scheduler (Feature 7)",
    "keywords": ["laravel", "mvc", "cse470", "consultations", "meeting-scheduler"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.10"
    },
    "require-dev": {
        "nunomaduro/collision": "^7.10",
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
